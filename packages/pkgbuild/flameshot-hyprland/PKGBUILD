# Flameshot from nottzaid/flameshot (branch hyprland-layer-shell): the capture
# overlay is a layer-shell surface, so it no longer takes a workspace's
# fullscreen slot and knocks maximized or fullscreen windows out of it.
# Built from Arch's flameshot PKGBUILD; install.sh builds it with makepkg.

pkgname=flameshot-hyprland
_commit=1b1cd912f89a62afe6eee46748bf724ab0992b5a
pkgver=14.0.0.r1.g1b1cd91
pkgrel=1
pkgdesc="Powerful yet simple to use screenshot software (layer-shell overlay for Hyprland)"
url="https://github.com/nottzaid/flameshot"
arch=('x86_64')
license=('GPL-3.0-or-later')
depends=('qt6-svg' 'hicolor-icon-theme' 'kguiaddons' 'layer-shell-qt' 'wayland' 'grim')
makedepends=('qt6-tools' 'cmake' 'git')
optdepends=('xdg-desktop-portal: screenshots outside Hyprland'
            'qt6-imageformats: for additional export image formats (e.g. tiff, webp, and more)')
provides=('flameshot')
conflicts=('flameshot')
source=("flameshot::git+${url}.git#commit=${_commit}")
sha256sums=('SKIP')

build() {
	cmake -B build -S flameshot \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DUSE_WAYLAND_CLIPBOARD=ON \
		-DUSE_LAYER_SHELL=ON \
		-DDISABLE_UPDATE_CHECKER=ON \
		-DUSE_KDSINGLEAPPLICATION=OFF \
		-Wno-dev
	cmake --build build
}

package() {
	DESTDIR="${pkgdir}" cmake --install build

	# Vendored static builds of shared libraries, as in Arch's package.
	rm -rf "${pkgdir}/usr/include/QtColorWidgets/" \
		"${pkgdir}/usr/include/kdsingleapplication-qt6/" \
		"${pkgdir}/usr/lib/cmake/KDSingleApplication-qt6/" \
		"${pkgdir}/usr/lib/cmake/QtColorWidgets/" \
		"${pkgdir}/usr/lib/libQtColorWidgets.a" \
		"${pkgdir}/usr/lib/libkdsingleapplication-qt6.a" \
		"${pkgdir}/usr/lib/pkgconfig/QtColorWidgets.pc"
	rmdir "${pkgdir}/usr/include/" "${pkgdir}/usr/lib/"{cmake,pkgconfig,} 2>/dev/null || true
}
