# Graphical-session environment for UWSM. UWSM also loads the login profile,
# so PATH and general variables come from Home Manager (modules/shell.nix).

export QT_QPA_PLATFORM="wayland;xcb"
export QT_QPA_PLATFORMTHEME="qt6ct"
export ELECTRON_OZONE_PLATFORM_HINT=auto
export HYPRCURSOR_THEME="Bibata-Modern-Ice"
export HYPRCURSOR_SIZE=24
export XCURSOR_THEME="Bibata-Modern-Ice"
export XCURSOR_SIZE=24

# Stop Wine from generating launcher entries/menus for everything it installs
# (Proton and Lutris already do this for their own prefixes).
export WINEDLLOVERRIDES="winemenubuilder.exe=d"
