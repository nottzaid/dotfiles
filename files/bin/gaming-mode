#!/usr/bin/env bash
# Gaming mode: while a game is on screen, nothing but the game and what it
# needs uses the CPU, GPU, VRAM or RAM; leaving the gaming workspace puts
# everything back. files/hypr/config/gaming.lua calls `gaming-mode sync` on
# every change to the gaming workspace (shown or not, which windows), and
# sync works out under a lock what should be, so events may arrive in any
# order: on while the gaming workspace is on screen with a window on it, and
# it stays on after the game's windows close, until the gaming workspace
# leaves the screen (the backdrop shows meanwhile).
#
# Nothing is named here; everything is found each time:
#   the game       the processes behind the gaming workspace's windows, every
#                  process that started them (a launcher or terminal reading
#                  the game's output would stop the game once the pipe fills)
#                  every process they started, and what those talk to over
#                  a unix socket (a wineserver another app started, say).
#                  Never touched, nor the compositor, nor this script and its
#                  callers.
#   services       a process owning a name under org.freedesktop.* on the
#                  session bus, any well-known name while it has no window, or
#                  a unit D-Bus started (dbus-*): a game may call them, and a
#                  call to a frozen one hangs. Kept running.
#   the shell      whatever owns layer surfaces (bar, wallpaper, dock,
#                  notifications, launcher): stopped, and started again after
#                  through its systemd unit, or with its exact command line,
#                  directory and environment, as the compositor started it.
#                  A layer rule first stops Hyprland from snapshotting each
#                  closing layer for a fade-out (a screen-sized framebuffer
#                  each, 74 MiB for a bar and wallpaper on two screens).
#   terminals      a terminal window whose one child on a terminal is a client
#                  of a session server (herdr, tmux, zellij, screen) running
#                  detached from it: closed (its VRAM is freed), and
#                  reopened attached to the same session on its own workspace,
#                  silently. (Its other children are its own helpers.)
#   other screens  shown the game: where the host has display-mode (the TV
#                  mirrors the monitor, or extends it), an extended TV is
#                  switched to mirror, and back after. Disconnecting it
#                  (freeing its VRAM) is for the TV block on the bar or the
#                  panel to ask: `display-mode off`, and `on` to have it back.
#   apps           every other unit in the user's app.slice: frozen (cgroup
#                  freezer: no CPU, no redraws) and their memory pushed out to
#                  swap. Their VRAM stays theirs; closing is the only way back.
#   cold swap      compressed swap (zram) is still RAM: what sits untouched in
#                  it (frozen apps' memory, the cold part of the game's) goes
#                  on to the disk behind it every WRITEBACK_LATER seconds of a
#                  stay, where it has one (system/libexec/zram-writeback),
#                  and comes back from there when read.
#   Steam's UI     the one thing named: steamwebhelper, the browser Steam
#                  draws its windows with (most of what Steam holds, 700 MiB
#                  or more), when the Steam behind it is part of the game
#                  (Steam started the game, which calls it) and the browser
#                  is not. Ended, the sandbox between it and Steam
#                  (srt-bwrap, pv-adverb) stopped first: Steam, which starts
#                  another within seconds of one ending, never learns it did.
#                  After, the sandbox goes on, finds it gone and exits, Steam
#                  starts a fresh one, and its main window and friends list,
#                  if they were open, open again where they were, silently.
#                  Steam itself keeps running.
# If finding the game, its sockets or the services fails, nothing changes.
#
# Leaving while the game's windows are still up is a visit to the desktop:
# everything comes back but the screens' layout (switching it reloads the
# compositor's config and blanks the screens, both ways) and Steam's UI,
# which comes back once the visit has lasted STEAM_LATER seconds; both go
# back as they were once the game's windows are gone, and the review panel
# shows then (or after a visit that did not restore everything). Work done
# with the game on screen runs at a lower priority than the game, and a
# frozen app goes to swap only once it has been frozen RECLAIM_LATER seconds,
# so a quick return to the desktop finds it still in memory.
#
#   gaming-mode sync      follow the gaming workspace (what gaming.lua runs)
#   gaming-mode on|off    force it, e.g. for a game kept off screen; sync
#                         leaves a forced on alone until off
#   gaming-mode pause     keep the desktop while a game is on screen (to chat
#                         or stream beside it) until `gaming-mode resume`
#   gaming-mode status    what is stopped, closed, disconnected, frozen
#   gaming-mode report    what still uses CPU or VRAM
#   gaming-mode backdrop  show or close the backdrop (what gaming.lua runs
#                         when a fullscreen window comes or goes)
#   gaming-mode act SESSION ACTION [ARG]
#                         what the review panel's buttons run (see act)
#
# Every change is recorded before it is made, and every step of leaving runs
# even if another fails and keeps its record until it succeeds; a failed
# leave is retried for a minute. Hyprland's not-responding dialog is off
# meanwhile (it would start a process per frozen window).
#
# While the desktop sleeps, the game's screen shows a still picture of it
# asleep (gaming-mode-art) wherever no window covers it; on the gaming
# workspace before any game (the lobby) the same picture waits for one,
# the desktop still awake (a launcher has to work). Each stay
# keeps a journal, and after leaving a panel (files/quickshell/gaming-mode,
# fed by gaming-mode-review) shows how everything came back and offers what
# can be done about the rest, once no game is on screen.
set -uo pipefail

STATE_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/gaming-mode"
USER_CG="/user.slice/user-$(id -u).slice/user@$(id -u).service"
APPS="/sys/fs/cgroup$USER_CG/app.slice"
DISPLAY_HELPER=/usr/local/libexec/gaming-mode-display
WRITEBACK_HELPER=/usr/local/libexec/zram-writeback
SYS=/sys # sysfs (tests point it elsewhere)
GAMING_WS=gaming
SELF=$(readlink -f "$0")
BIN_DIR=${GAMING_MODE_BIN:-$HOME/.local/bin} # gaming-mode-art, gaming-mode-review
ART_CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/gaming-mode # pictures drawn ahead (gaming-mode-art)

ON=$STATE_DIR/on               # present while on
PINNED=$STATE_DIR/pinned       # forced on: sync does not leave
PAUSED=$STATE_DIR/paused       # paused: sync keeps the desktop as it is
RETRIES=$STATE_DIR/retries     # failed leaves in a row
CLAIMED=$STATE_DIR/claimed     # processes a restore has already counted as its own
ANR=$STATE_DIR/anr             # the not-responding dialog setting before
NOANIM=$STATE_DIR/noanim       # the no-fade layer rule is set
NOANIM_RULE='GamingModeNoAnim = hl.layer_rule({ name = "gaming-mode-no-anim", match = { namespace = ".*" }, no_anim = true })'
SHELLS=$STATE_DIR/shell        # one directory per stopped shell process
TERMS=$STATE_DIR/terms         # one directory per closed terminal
DISPLAYS=$STATE_DIR/displays   # disconnected connectors, one per line
FROZEN=$STATE_DIR/frozen       # cgroups this script froze, one per line
STEAMUI=$STATE_DIR/steam-ui    # Steam's UI ended: parked (pid start), windows (title workspace)
LEFT=$STATE_DIR/left           # a leave has run since enter (with ON: it is incomplete); its trigger
VISIT=$STATE_DIR/visit         # a visit to the desktop began then (seconds since boot)
SESSIONS=$STATE_DIR/sessions   # one directory per stay, its journal in events.jsonl
SESSION=$STATE_DIR/session     # the name of the current (or last) one
BACKDROP=$STATE_DIR/backdrop   # the backdrop's unit, output and picture, one line
WALLS=$STATE_DIR/walls         # the outputs that showed a wallpaper before
REVIEW=$STATE_DIR/review       # the review panel is due once no game is on screen
MIRRORED=$STATE_DIR/mirrored   # this stay switched the screens to mirror
PANEL_UNIT=gaming-mode-panel.service
LOG=$STATE_DIR/log
STEAM_LATER=20                 # seconds into a visit before Steam's UI comes back
RECLAIM_LATER=30               # seconds into a stay before frozen apps go to swap
WRITEBACK_LATER=120            # seconds untouched in zram swap before it goes to disk
ENTER_TRIGGER=workspace        # why enter or leave runs, for the journal
LEAVE_TRIGGER=left

log() { printf '%s %s\n' "$(date +%T.%3N)" "$*" >>"$LOG"; }
cgroup_of() { sed -n 's/^0:://p' "/proc/$1/cgroup" 2>/dev/null; }
parent_of() { awk '/^PPid:/ {print $2}' "/proc/$1/status" 2>/dev/null; }
sid_of() { ps -o sid= -p "$1" 2>/dev/null | tr -d ' '; }
tty_of() { ps -o tty= -p "$1" 2>/dev/null | tr -d ' '; }
has() { grep -qxF -- "$2" <<<"$1"; } # has LINES LINE

# A process's start time (clock ticks since boot): with the pid, it names one
# process for good, where a pid alone may be reused.
starttime_of() {
    local s
    local -a f
    { read -r s <"/proc/$1/stat"; } 2>/dev/null || return 1
    read -r -a f <<<"${s##*) }"
    echo "${f[19]}"
}
state_of() { # state_of PID: R, S, T (stopped), Z (ended)...
    local s
    { read -r s <"/proc/$1/stat"; } 2>/dev/null || return 1
    s=${s##*) }
    echo "${s%% *}"
}
# same_process PID START: that very process, still running (a zombie has
# ended though it keeps its pid and start time).
same_process() {
    local s
    local -a f
    { read -r s <"/proc/$1/stat"; } 2>/dev/null || return 1
    read -r -a f <<<"${s##*) }"
    [[ -n $2 && ${f[19]} == "$2" && ${f[0]} != Z ]]
}

# The time since boot, in seconds or in the clock ticks process start times
# use: a clock that never goes back.
CLK=$(getconf CLK_TCK)
uptime_s() { local up; read -r up _ </proc/uptime; echo "${up%.*}"; }
uptime_ticks() {
    local up
    read -r up _ </proc/uptime
    echo $((${up%.*} * CLK + 10#${up#*.} * CLK / 100))
}

# Replace a record with CONTENT (removing it when empty) by an atomic rename,
# so an interruption leaves the old record whole.
write_lines() {
    if [[ -z $2 ]]; then
        rm -f "$1"
    else
        printf '%s' "$2" >"$1.new" && mv -f "$1.new" "$1"
    fi
}

# covers CGROUP LIST: the cgroup is one of LIST, or above one (freezing is
# recursive, so freezing it would freeze that one too).
covers() {
    local e
    while IFS= read -r e; do
        [[ -n $e && ($e == "$1" || $e == "$1/"*) ]] && return 0
    done <<<"$2"
    return 1
}

drop_line() { # drop_line FILE LINE
    local rest status
    [[ -e $1 ]] || return 0
    rest=$(grep -vxF -- "$2" "$1") && status=0 || status=$?
    ((status <= 1)) || return 1 # unreadable: keep the record whole
    write_lines "$1" "${rest:+$rest$'\n'}"
}

# Run this script's sync again in N seconds, detached and without the lock.
sync_later() { (sleep "$1" && exec "$SELF" sync) 9>&- >/dev/null 2>&1 & }

# --- the journal -------------------------------------------------------------

# Each stay keeps a journal, one JSON object per line, that gaming-mode-review
# reads: what was found, what was done to it and how that went. The records
# above stay the truth about what is still to restore; the journal is the
# story. Written without a process per line, and never failing anything.

# json_str VAR TEXT: TEXT as a JSON string, into VAR.
json_str() {
    local -n json_out=$1
    local s=$2
    s=${s//\\/\\\\}
    s=${s//\"/\\\"}
    s=${s//$'\n'/\\n}
    s=${s//$'\t'/\\t}
    s=${s//[[:cntrl:]]/}
    # shellcheck disable=SC2034 # a nameref: sets the caller's VAR
    json_out="\"$s\""
}

# note KIND [KEY=TEXT | KEY:=JSON]...: add an event to this stay's journal
# (NOTE_DIR's, when set).
note() {
    local dir=${NOTE_DIR:-} id line v kv
    if [[ -z $dir ]]; then
        { read -r id <"$SESSION"; } 2>/dev/null || return 0
        dir=$SESSIONS/$id
    fi
    [[ -d $dir ]] || return 0
    json_str v "$1"
    line="{\"kind\":$v,\"t\":${EPOCHREALTIME/,/.}"
    shift
    for kv in "$@"; do
        if [[ $kv =~ ^([a-z_]+):=(.*)$ ]]; then
            line+=",\"${BASH_REMATCH[1]}\":${BASH_REMATCH[2]:-null}"
        elif [[ $kv =~ ^([a-z_]+)=(.*)$ ]]; then
            json_str v "${BASH_REMATCH[2]}"
            line+=",\"${BASH_REMATCH[1]}\":$v"
        fi
    done
    printf '%s}\n' "$line" >>"$dir/events.jsonl" 2>/dev/null
    return 0
}

# A journal for a new stay. The last ten stays are kept, and the pictures
# drawn for the last one only.
new_session() {
    local id
    local -a all
    printf -v id '%(%Y%m%d-%H%M%S)T-%s' -1 "${EPOCHREALTIME#*[.,]}"
    rm -f "$SESSIONS"/*/backdrop-*.png
    mkdir -p "$SESSIONS/$id" && echo "$id" >"$SESSION" || return 0
    all=("$SESSIONS"/*/)
    if ((${#all[@]} > 10)); then rm -rf -- "${all[@]:0:${#all[@]}-10}"; fi
}

# The windows on the gaming workspace (from CLIENTS, or asked), as JSON.
game_windows() {
    jq -c --arg ws "$GAMING_WS" '[.[] | select(.workspace.name == $ws) | {pid, class, title, fullscreen}]' \
        <<<"${CLIENTS:-$(hyprctl -j clients)}" 2>/dev/null || echo null
}

# VRAM per process, "PID MiB", as the driver accounts it; nothing without
# NVIDIA's tools.
vram_by_pid() {
    command -v nvidia-smi >/dev/null || return 0
    nvidia-smi 2>/dev/null | awk '$6 ~ /^(G|C|C\+G)$/ && $(NF-1) ~ /^[0-9]+MiB$/ { print $5, $(NF-1) + 0 }'
}

# --- what is on screen ----------------------------------------------------

# 0 when the gaming workspace is shown with a window on it, 1 when not shown,
# 2 when Hyprland can't be asked, 3 when it is shown but empty.
gaming_shown() {
    local monitors workspaces
    monitors=$(hyprctl -j monitors) || return 2
    workspaces=$(hyprctl -j workspaces) || return 2
    jq -e --arg ws "$GAMING_WS" 'any(.[]; .activeWorkspace.name == $ws)' <<<"$monitors" >/dev/null || return 1
    jq -e --arg ws "$GAMING_WS" 'any(.[]; .name == $ws and .windows > 0)' <<<"$workspaces" >/dev/null || return 3
}

# The processes at the other end of any unix socket of the given processes:
# what the game talks to (Xwayland, the audio server, a wineserver that
# another app started) must not be frozen under it.
socket_peers() {
    ss -xpn | awk -v want=" $* " '
        NR > 1 {
            rest = $0
            while (match(rest, /pid=[0-9]+/)) {
                p = substr(rest, RSTART + 4, RLENGTH - 4)
                owners[$6] = owners[$6] " " p
                if (index(want, " " p " ")) mine[$8] = 1
                rest = substr(rest, RSTART + RLENGTH)
            }
        }
        END { for (i in mine) if (i in owners) print owners[i] }' | tr ' ' '\n' | sed '/^$/d'
}

# Sets CLIENTS, GAME_PIDS (the windows' processes), GAME_TREE (them and all
# below them), PROTECTED (pids that must keep running), PROTECTED_CG (their
# cgroups) and SERVICES (see services). Fails if anything can't be read, or a
# game process is not in the user's apps.
discover() {
    local pid up cg tree peers hypr
    local -a queue
    CLIENTS=$(hyprctl -j clients) || return 1
    GAME_PIDS=$(jq -r --arg ws "$GAMING_WS" '.[] | select(.workspace.name == $ws) | .pid | select(. > 0)' <<<"$CLIENTS") ||
        return 1
    GAME_PIDS=$(sort -u <<<"$GAME_PIDS")
    [[ -n $GAME_PIDS ]] || return 1
    for pid in $GAME_PIDS; do
        cg=$(cgroup_of "$pid")
        [[ $cg == "$USER_CG/app.slice/"* ]] || { log "game pid $pid is in '$cg', not an app: unsure"; return 1; }
    done
    tree=$(
        for pid in $GAME_PIDS; do
            queue=("$pid")
            while ((${#queue[@]})); do
                echo "${queue[0]}"
                mapfile -t -O "${#queue[@]}" queue < <(pgrep -P "${queue[0]}")
                queue=("${queue[@]:1}")
            done
        done
    )
    GAME_TREE=$tree
    # shellcheck disable=SC2086 # one pid per word
    peers=$(socket_peers $tree) || { log "sockets unreadable: unsure"; return 1; }
    hypr=$(pgrep -x Hyprland) || return 1
    PROTECTED=$(
        echo "$tree"
        for pid in $GAME_PIDS $$; do
            up=$pid
            while [[ -n $up ]] && ((up > 1)); do echo "$up"; up=$(parent_of "$up"); done
        done
        echo "$peers"
        echo "$hypr"
    )
    PROTECTED=$(sed '/^$/d' <<<"$PROTECTED" | sort -u)
    PROTECTED_CG=$(for pid in $PROTECTED; do cgroup_of "$pid"; done | sort -u)
    # A service restarting while it is looked up is looked up again.
    for _ in 1 2 3; do SERVICES=$(services) && return 0; sleep 0.2; done
    log "session bus services unreadable: unsure"
    return 1
}

# The cgroups of D-Bus services (see the top). Fails if the bus can't be read
# or an owner can't be placed (it ended, and may be restarting elsewhere).
services() {
    local names owners pid cg
    names=$(busctl --user list --json=short) || return 1
    owners=$(jq -r --argjson clients "$CLIENTS" '
        [$clients[].pid] as $windowed
        | .[] | select(.pid != null)
        | select((.name | startswith("org.freedesktop.")) or
                 ((.name | startswith(":") | not) and (.pid as $p | $windowed | index($p) | not)))
        | .pid' <<<"$names") || return 1
    for pid in $(sort -u <<<"$owners"); do
        cg=$(cgroup_of "$pid")
        [[ -n $cg ]] || return 1
        echo "$cg"
    done
    find "$APPS" -mindepth 1 -type d -name 'dbus-*' -printf "$USER_CG/app.slice/%P\n" || return 1
}

# --- launching like the compositor does -------------------------------------

save_process() { # save_process PID DIR: command line, environment, directory, cgroup
    mkdir -p "$2" &&
        cat "/proc/$1/cmdline" >"$2/cmdline" 2>/dev/null &&
        cat "/proc/$1/environ" >"$2/environ" 2>/dev/null &&
        readlink "/proc/$1/cwd" >"$2/cwd" 2>/dev/null &&
        cgroup_of "$1" >"$2/cgroup"
}

# A shell command that runs a saved process again exactly (same directory,
# environment and arguments, plus extra arguments). One that had a scope of
# its own in the apps (as uwsm or a launcher gives one) gets a new scope in
# the same slice, named alike with a fresh suffix.
replay_cmd() {
    local dir=$1 cmd e a cg unit slice
    shift
    local -a env argv
    mapfile -d '' -t env <"$dir/environ"
    mapfile -d '' -t argv <"$dir/cmdline"
    cmd="cd $(printf %q "$(<"$dir/cwd")") && exec"
    cg=$(<"$dir/cgroup")
    unit=${cg##*/}
    slice=${cg%/*}
    slice=${slice##*/}
    if [[ $cg == "$USER_CG/app.slice/"* && $unit == *.scope && $slice == *.slice ]]; then
        unit=${unit%.scope}
        [[ $unit =~ ^(.+)-[0-9a-f]+$ ]] && unit=${BASH_REMATCH[1]}
        unit+=-$(printf '%04x%04x' $RANDOM $RANDOM).scope
        cmd+=" systemd-run --user --scope --quiet --slice=$(printf %q "$slice") --unit=$(printf %q "$unit") --"
    fi
    # Hyprland hands each launch fresh tokens (HL_EXEC_RULE_TOKEN and the
    # like) that it later finds in the window's environment to apply that
    # launch's rules: those come from this launch, never from the old one.
    cmd+=" env -i"
    for e in "${env[@]}"; do [[ $e == HL_* ]] || cmd+=" $(printf %q "$e")"; done
    # shellcheck disable=SC2016 # expanded by the shell Hyprland starts
    cmd+=' $(env | grep "^HL_")'
    for a in "${argv[@]}" "$@"; do cmd+=" $(printf %q "$a")"; done
    printf '%s' "$cmd"
}

# Run a shell command through Hyprland, with optional window rules (the body
# of a Lua table), so it starts where the compositor's own launches do.
compositor_exec() {
    local cmd=$1 rules=${2:-} level='==' tail=''
    while [[ $cmd == *"]$level]"* ]]; do level+='='; done
    [[ -n $rules ]] && tail=", { $rules }"
    hyprctl dispatch "hl.dsp.exec_cmd([${level}[$cmd]${level}]$tail)" >/dev/null
}

# running_like FILE SINCE: a running process whose command line is FILE's,
# started at or after SINCE (clock ticks since boot), that no other restore
# has counted as its own. Claims it, its pid in RUNNING_PID.
running_like() {
    local p pid s claimed i
    local -a f want have
    claimed=$(cat "$CLAIMED" 2>/dev/null)
    mapfile -d '' -t want <"$1" && ((${#want[@]})) || return 1
    # Compared in the shell: a command per process would cost a fork for
    # each of the few hundred, every tenth of a second while waiting.
    for p in /proc/[0-9]*; do
        pid=${p#/proc/}
        { mapfile -d '' -t have <"$p/cmdline"; } 2>/dev/null || continue
        ((${#have[@]} == ${#want[@]})) || continue
        for i in "${!want[@]}"; do [[ ${have[i]} == "${want[i]}" ]] || continue 2; done
        has "$claimed" "$pid" && continue
        { read -r s <"$p/stat"; } 2>/dev/null || continue
        read -r -a f <<<"${s##*) }"
        [[ ${f[0]} != Z ]] && ((f[19] >= $2)) || continue
        echo "$pid" >>"$CLAIMED"
        RUNNING_PID=$pid
        return 0
    done
    return 1
}

# Give a reopened window back the focus it had when it was closed, but only
# if nothing has focus and its workspace is the focused screen's: never moving
# the view, never taking focus from anything. Checked and done in one step
# inside the compositor.
refocus() { # refocus PID
    local addr ws
    for _ in $(seq 1 30); do
        addr=$(hyprctl -j clients | jq -r --argjson p "$1" 'first(.[] | select(.pid == $p) | .address) // empty')
        [[ -n $addr ]] && break
        sleep 0.1
    done
    [[ -n $addr ]] || return 0
    ws=$(hyprctl -j clients | jq -r --arg a "$addr" '.[] | select(.address == $a) | .workspace.name') || return 0
    [[ $addr =~ ^0x[0-9a-f]+$ && $ws != *"]==]"* ]] || return 0
    hyprctl eval "local m = hl.get_active_monitor()
        if hl.get_active_window() == nil and m and m.active_workspace and m.active_workspace.name == [==[$ws]==] then
            hl.dispatch(hl.dsp.focus({ window = 'address:$addr' }))
        end" >/dev/null
}

# Start a saved process again through Hyprland and wait until it runs. One
# started since it was stopped (by a supervisor, or by an earlier, slow
# launch of ours) counts. Three launches that never showed are a failure:
# the record stays (status lists it) and nothing is started a fourth time.
relaunch() { # relaunch DIR EXPECTED-CMDLINE-FILE [RULES] [EXTRA ARGS...]
    local dir=$1 expect=$2 rules=$3 tries since
    shift 3
    since=$(cat "$dir/since" 2>/dev/null || echo 0)
    running_like "$expect" "$since" && return 0
    tries=$(cat "$dir/tries" 2>/dev/null || echo 0)
    if ((tries >= 3)); then
        log "not started again after $tries tries: $(tr '\0' ' ' <"$expect")"
        return 1
    fi
    compositor_exec "$(replay_cmd "$dir" "$@")" "$rules" || return 1
    echo $((tries + 1)) >"$dir/tries"
    for _ in $(seq 1 50); do running_like "$expect" "$since" && return 0; sleep 0.1; done
    log "not running 5 s after starting: $(tr '\0' ' ' <"$expect")"
    return 1
}

# --- the shell --------------------------------------------------------------

stop_shell() {
    local layers pids pid cg unit main n child alive
    local -A started=()
    layers=$(hyprctl -j layers) || { log "layers unreadable: shell left running"; return 1; }
    pids=$(jq -r '[.[].levels[][] | .pid] | unique[]' <<<"$layers")
    # (Never the game's, nor this script's own: the backdrop and the panel.)
    pids=$(for pid in $pids; do
        has "$PROTECTED" "$pid" || [[ $(cgroup_of "$pid") == */gaming-mode-* ]] || echo "$pid"
    done)
    [[ -n $pids ]] || return 0
    if [[ ! -e $NOANIM ]]; then
        hyprctl eval "$NOANIM_RULE" >/dev/null && touch "$NOANIM"
    fi
    mkdir -p "$SHELLS"
    for pid in $pids; do
        cg=$(cgroup_of "$pid")
        [[ -n $cg ]] || continue
        unit=${cg##*/}
        # Its own service (it is the main process, and the unit holds nothing
        # protected): stop the unit. Otherwise only the process.
        if [[ $unit == *.service ]] && ! covers "$cg" "$PROTECTED_CG"; then
            main=$(systemctl --user show -p MainPID --value -- "$unit" 2>/dev/null)
            if [[ $main == "$pid" ]]; then
                n=$(mktemp -d "$SHELLS/XXXX") || continue
                echo "$unit" >"$n/unit" || { rm -rf "$n"; continue; }
                if systemctl --user stop -- "$unit"; then
                    log "stopped unit $unit"
                    note stop name="${unit%.service}" record="${n##*/}"
                else
                    rm -rf "$n"
                fi
                continue
            fi
        fi
        # Only a process whose record is complete is stopped.
        n=$(mktemp -d "$SHELLS/XXXX") || continue
        if ! save_process "$pid" "$n" || ! started[$pid]=$(starttime_of "$pid"); then
            rm -rf "$n"
            unset "started[$pid]"
            continue
        fi
        uptime_ticks >"$n/since"
        for child in $(pgrep -P "$pid"); do has "$PROTECTED" "$child" || kill -TERM "$child" 2>/dev/null; done
        if kill -TERM "$pid" 2>/dev/null; then
            log "stopped $(tr '\0' ' ' <"$n/cmdline")"
            note stop name="$(cat "/proc/$pid/comm" 2>/dev/null)" record="${n##*/}"
        fi
    done
    for _ in $(seq 1 50); do
        alive=0
        for pid in "${!started[@]}"; do same_process "$pid" "${started[$pid]}" && alive=1; done
        ((alive)) || break
        sleep 0.1
    done
    for pid in "${!started[@]}"; do same_process "$pid" "${started[$pid]}" && kill -KILL "$pid" 2>/dev/null; done
    rmdir "$SHELLS" 2>/dev/null
    return 0
}

start_shell() {
    local n failed=0 id
    for n in "$SHELLS"/*/; do
        [[ -d $n ]] || continue
        id=${n%/}
        id=${id##*/}
        if [[ -e $n/unit ]]; then
            if systemctl --user start -- "$(<"$n/unit")"; then
                note restart record="$id" ok:=true
                keep_restored "$n"
            else
                note restart record="$id" ok:=false
                failed=1
            fi
            continue
        fi
        # (A supervisor may have started it again meanwhile.)
        if relaunch "$n" "$n/cmdline" ""; then
            note restart record="$id" ok:=true
            keep_restored "$n"
        else
            note restart record="$id" ok:=false tries:="$(cat "$n/tries" 2>/dev/null || echo 0)"
            failed=1
        fi
    done
    rmdir "$SHELLS" 2>/dev/null
    return $failed
}

# A shell's record, once it runs again, goes with the stay's journal: the
# panel can start it again from there should it exit later.
keep_restored() { # keep_restored RECORD-DIR
    local id name=${1%/}
    name=${name##*/}
    if { read -r id <"$SESSION"; } 2>/dev/null && mkdir -p "$SESSIONS/$id/restored"; then
        rm -rf "${SESSIONS:?}/$id/restored/$name"
        mv "$1" "$SESSIONS/$id/restored/$name" 2>/dev/null && return 0
    fi
    rm -rf "$1"
}

restore_layer_fades() {
    [[ -e $NOANIM ]] || return 0
    # Let the shell's layers map without a fade first.
    for _ in $(seq 1 30); do
        (($(hyprctl -j layers | jq '[.[].levels[][]] | length') > 0)) && break
        sleep 0.1
    done
    hyprctl eval 'if GamingModeNoAnim then pcall(function() GamingModeNoAnim:set_enabled(false) end) end
        GamingModeNoAnim = nil' >/dev/null && rm -f "$NOANIM"
}

# --- terminals over session servers ----------------------------------------

# How to attach again from a session client's process: the command, one
# argument per line, or a failure if it is not a client this knows.
reattach_args() {
    local pid=$1 name
    case "$(cat "/proc/$pid/comm" 2>/dev/null)" in
        herdr) tr '\0' '\n' <"/proc/$pid/cmdline" ;; # `herdr [--session X]` attaches
        tmux)
            name=$(tmux list-clients -F '#{client_pid} #{session_name}' 2>/dev/null | awk -v p="$pid" '$1 == p {print $2}')
            [[ -n $name ]] && printf '%s\n' tmux attach-session -t "$name"
            ;;
        zellij)
            name=$(tr '\0' '\n' <"/proc/$pid/environ" | sed -n 's/^ZELLIJ_SESSION_NAME=//p')
            [[ -n $name ]] && printf '%s\n' zellij attach "$name"
            ;;
        screen)
            name=$(tr '\0' '\n' <"/proc/$pid/environ" | sed -n 's/^STY=//p')
            [[ -n $name ]] && printf '%s\n' screen -r "$name"
            ;;
        *) return 1 ;;
    esac
}

# The flag a terminal takes before a command to run ("" when it takes the
# command bare); fails for a terminal this does not know. (Terminals that
# serve several windows from one process are left alone below anyway.)
exec_flag() {
    case "$1" in
        kitty | foot) echo "" ;;
        alacritty | ghostty | konsole | xterm) echo "-e" ;;
        *) return 1 ;;
    esac
}

close_terminals() {
    local pids pid ws flag child n sub sids exe ok keep start focused term client
    local -a sessions targv cargv
    pids=$(jq -r '[.[].pid] | group_by(.) | map(select(length == 1) | .[0])[]' <<<"$CLIENTS")
    focused=$(hyprctl -j activewindow | jq -r '.pid // empty')
    for pid in $pids; do
        has "$PROTECTED" "$pid" && continue
        flag=$(exec_flag "$(cat "/proc/$pid/comm" 2>/dev/null)") || continue
        # Its one child on a terminal (the others are its own helpers).
        sessions=()
        for child in $(pgrep -P "$pid"); do
            [[ $(tty_of "$child") == "?" ]] || sessions+=("$child")
        done
        ((${#sessions[@]} == 1)) || continue
        child=${sessions[0]}
        reattach_args "$child" >/dev/null || continue
        # Below the client, a process of the same program is its server: it
        # must be in a session of its own, or closing the terminal would hang
        # it up too. Anything else there is the client's own helper (herdr's
        # ssh to remote hosts), which goes with it and comes back with it.
        sids=" $(sid_of "$pid") $(sid_of "$child") "
        exe=$(readlink "/proc/$child/exe")
        ok=1
        for sub in $(pgrep -P "$child"); do
            [[ $(readlink "/proc/$sub/exe") == "$exe" && $sids == *" $(sid_of "$sub") "* ]] && ok=0
        done
        ((ok)) || continue
        ws=$(jq -r --argjson p "$pid" '.[] | select(.pid == $p) | .workspace.name' <<<"$CLIENTS")
        start=$(starttime_of "$pid") || continue
        mkdir -p "$TERMS"
        n=$(mktemp -d "$TERMS/XXXX") || continue
        save_process "$pid" "$n" || { rm -rf "$n"; continue; }
        # The terminal's own arguments: without the client, if it was
        # started with it as its command (and the flag before it).
        mapfile -d '' -t targv <"$n/cmdline"
        mapfile -d '' -t cargv <"/proc/$child/cmdline"
        keep=${#targv[@]}
        if ((${#cargv[@]} && ${#cargv[@]} < keep)) && [[ ${targv[*]: -${#cargv[@]}} == "${cargv[*]}" ]]; then
            keep=$((keep - ${#cargv[@]}))
            [[ -n $flag && ${targv[keep - 1]} == "$flag" ]] && keep=$((keep - 1))
        fi
        [[ $pid == "$focused" ]] && touch "$n/focused"
        echo "$pid $start" >"$n/orig"
        uptime_ticks >"$n/since"
        if ! printf '%s\0' "${targv[@]:0:keep}" >"$n/cmdline" || ! echo "$ws" >"$n/workspace" ||
            ! { [[ -z $flag ]] || echo "$flag"; reattach_args "$child"; } >"$n/attach"; then
            rm -rf "$n"
            continue
        fi
        term=$(cat "/proc/$pid/comm" 2>/dev/null)
        client=$(cat "/proc/$child/comm" 2>/dev/null)
        kill -TERM "$pid" 2>/dev/null
        for _ in $(seq 1 50); do same_process "$pid" "$start" || break; sleep 0.1; done
        # A terminal still closing keeps its record: leaving finds it open
        # (nothing to do) or gone (reopened).
        if same_process "$pid" "$start"; then
            log "terminal $pid not closed after 5 s"
        else
            log "closed terminal $pid on workspace $ws"
            note close terminal="$term" client="$client" workspace="$ws" record="${n##*/}"
        fi
    done
    rmdir "$TERMS" 2>/dev/null
    return 0
}

reopen_terminals() {
    local n failed=0 ws pid start id
    local -a extra argv
    for n in "$TERMS"/*/; do
        [[ -d $n ]] || continue
        # Never closed (it ignored the request, or is still closing with its
        # window up): nothing to reopen.
        read -r pid start <"$n/orig"
        if same_process "$pid" "$start" &&
            hyprctl -j clients | jq -e --argjson p "$pid" 'any(.[]; .pid == $p)' >/dev/null; then
            rm -rf "$n"
            continue
        fi
        mapfile -t extra <"$n/attach"
        mapfile -d '' -t argv <"$n/cmdline"
        printf '%s\0' "${argv[@]}" "${extra[@]}" >"$n/expect"
        ws=$(<"$n/workspace")
        [[ $ws =~ ^[0-9]+$ ]] || ws="name:$ws"
        RUNNING_PID=
        id=${n%/}
        id=${id##*/}
        if relaunch "$n" "$n/expect" "workspace = \"$ws silent\", no_initial_focus = true" "${extra[@]}"; then
            [[ -e $n/focused && -n $RUNNING_PID ]] && refocus "$RUNNING_PID"
            note reopen record="$id" ok:=true
            rm -rf "$n"
        else
            note reopen record="$id" ok:=false tries:="$(cat "$n/tries" 2>/dev/null || echo 0)"
            failed=1
        fi
    done
    rmdir "$TERMS" 2>/dev/null
    return $failed
}

# --- other screens ---------------------------------------------------------

# Other screens show the game rather than go dark. Where the host switches
# layouts with display-mode (files/bin/display-mode: the TV mirrors the
# monitor, or the two extend each other), an extended TV is switched to
# mirror the monitor, where the gaming workspace lives (host.lua), and back
# to extended after, unless the layout was changed meanwhile (that is fine:
# the gaming workspace stays on the monitor either way). Nothing is
# disconnected unless asked (display-mode off, from the bar or the panel); a
# TV disconnected so, or unplugged, comes back mirroring while the stay lasts.
mirror_screens() {
    local mode before
    [[ -x $BIN_DIR/display-mode ]] || return 0
    mode=$("$BIN_DIR/display-mode" status 2>/dev/null) || return 0
    if [[ $mode == off || $mode == none ]] && before=$("$BIN_DIR/display-mode" record mirror 9>&- </dev/null 2>/dev/null); then
        [[ $before == extended ]] && touch "$MIRRORED"
        note screen action=kept layout="$mode" later=mirror
        return 0
    fi
    if [[ $mode != extended ]]; then
        note screen action=kept layout="$mode"
        return 0
    fi
    touch "$MIRRORED"
    if "$BIN_DIR/display-mode" mirror 9>&- </dev/null >/dev/null 2>&1; then
        log "mirrored the screens"
        note screen action=mirror ok:=true
    else
        rm -f "$MIRRORED"
        log "could not mirror the screens"
        note screen action=mirror ok:=false
    fi
}

# Back to extended, if this stay mirrored and the layout is still mirror; a
# TV disconnected or unplugged meanwhile comes back extended.
unmirror_screens() {
    local mode
    [[ -e $MIRRORED ]] || return 0
    mode=$("$BIN_DIR/display-mode" status 2>/dev/null) || return 1
    if [[ $mode == mirror ]]; then
        if ! "$BIN_DIR/display-mode" extended 9>&- </dev/null >/dev/null 2>&1; then
            note screen action=extend ok:=false
            return 1
        fi
        log "extended the screens again"
    elif [[ $mode == off || $mode == none ]]; then
        if ! "$BIN_DIR/display-mode" record extended 9>&- </dev/null >/dev/null 2>&1; then
            note screen action=extend ok:=false found="$mode"
            return 1
        fi
        log "the TV comes back extended"
    fi
    note screen action=extend ok:=true found="$mode"
    rm -f "$MIRRORED"
}

# Screens disconnected by an earlier version of this script (which turned
# other screens off): handed back to hotplug detection, like any record.
# Hand the connectors back to hotplug detection and wait for Hyprland to
# have each screen again. One that reports nothing attached (a TV switched off
# meanwhile) is as restored as it can be; one attached that Hyprland does not
# show stays recorded, and leaving is tried again.
reconnect_displays() {
    local connector failed=0 left="" name status
    [[ -e $DISPLAYS ]] || return 0
    while IFS= read -r connector; do
        [[ -n $connector ]] || continue
        if ! sudo -n "$DISPLAY_HELPER" detect "$connector"; then
            note reconnect name="${connector#card*-}" connector="$connector" ok:=false
            left+="$connector"$'\n'
            failed=1
            continue
        fi
        name=${connector#card*-}
        for _ in $(seq 1 50); do
            # (Plain "monitors" leaves out a screen that mirrors another.)
            if hyprctl -j monitors all | jq -e --arg n "$name" 'any(.[]; .name == $n and (.disabled | not))' >/dev/null; then
                note reconnect name="$name" connector="$connector" ok:=true
                continue 2
            fi
            status=$(cat "$SYS/class/drm/$connector/status" 2>/dev/null)
            if [[ $status == disconnected ]]; then
                log "$connector: nothing attached"
                note reconnect name="$name" connector="$connector" ok:=true attached:=false
                continue 2
            fi
            sleep 0.1
        done
        log "$connector reconnected, but Hyprland has no $name yet"
        note reconnect name="$name" connector="$connector" ok:=false
        left+="$connector"$'\n'
        failed=1
    done <"$DISPLAYS"
    write_lines "$DISPLAYS" "$left"
    return $failed
}

# --- apps --------------------------------------------------------------------

freeze_apps() {
    local dir cg mem pid class name key value ooms
    local -a new=()
    local -A classes=()
    # An app is named for the journal by a window of its own (steam, not the
    # game's launcher entry its unit was started from), if it has one.
    while read -r pid class; do classes[$pid]=$class; done < <(jq -r '.[] | "\(.pid) \(.class)"' <<<"$CLIENTS")
    while IFS= read -r dir; do
        [[ -n $(<"$dir/cgroup.procs") ]] || continue  # (cgroup files have no size)
        [[ $(<"$dir/cgroup.freeze") == 0 ]] || continue # frozen already
        cg=${dir#/sys/fs/cgroup}
        covers "$cg" "$PROTECTED_CG" && continue
        covers "$cg" "$SERVICES" && continue
        echo "$dir" >>"$FROZEN" || continue
        if echo 1 >"$dir/cgroup.freeze"; then
            log "froze ${cg##*/}"
            { read -r mem <"$dir/memory.current"; } 2>/dev/null || mem=0
            name=""
            while read -r pid; do
                [[ -n ${classes[$pid]:-} ]] && { name=${classes[$pid]}; break; }
            done <"$dir/cgroup.procs"
            # (Its OOM kills so far: the review counts only those since.)
            ooms=0
            while read -r key value; do [[ $key == oom_kill ]] && ooms=$value; done <"$dir/memory.events"
            note freeze cgroup="${dir#"$APPS"/}" name="$name" memory:="$((mem / 1048576))" oom_kills:="$ooms"
            new+=("$dir")
        else
            drop_line "$FROZEN" "$dir"
        fi
    done < <(find "$APPS" -mindepth 1 -type d)
    ((${#new[@]})) && reclaim_cold "${new[@]}"
    return 0
}

# Frozen pages are cold by construction: swap them out now rather than when
# the game needs the RAM. In the background, a little at a time and only on
# CPU time nothing else wants (compressing pages into swap is real work), so
# it never competes with the game; each cgroup until it is thawed or gives
# nothing more back.
reclaim_cold() {
    local id
    { read -r id <"$SESSION"; } 2>/dev/null || id=""
    (
        exec 9>&- >/dev/null 2>&1
        chrt --idle -p 0 "$BASHPID" || renice -n 19 -p "$BASHPID"
        sleep "$RECLAIM_LATER"
        # (Only for this stay: the app may be thawed and frozen again since.)
        for dir in "$@"; do
            while [[ $(<"$SESSION") == "$id" && $(<"$dir/cgroup.freeze") == 1 ]] && echo 32M >"$dir/memory.reclaim"; do :; done
        done 2>/dev/null
    ) &
}

# Thaw what this script froze: all of it, or with "protected" only what is
# now part of the game (or above it).
thaw_apps() {
    local dir left="" failed=0 swap
    [[ -e $FROZEN ]] || return 0
    while IFS= read -r dir; do
        if [[ ${1:-} == protected ]] && ! covers "${dir#/sys/fs/cgroup}" "$PROTECTED_CG"; then
            left+="$dir"$'\n'
            continue
        fi
        if [[ ! -e $dir/cgroup.freeze ]]; then
            note thaw cgroup="${dir#"$APPS"/}" ok:=true gone:=true
            continue
        fi
        # (What went to swap meanwhile, for the review.)
        { read -r swap <"$dir/memory.swap.current"; } 2>/dev/null || swap=0
        if echo 0 >"$dir/cgroup.freeze"; then
            note thaw cgroup="${dir#"$APPS"/}" ok:=true swap:="$((swap / 1048576))" game:="$([[ ${1:-} == protected ]] && echo true || echo false)"
        else
            note thaw cgroup="${dir#"$APPS"/}" ok:=false
            left+="$dir"$'\n'
            failed=1
        fi
    done <"$FROZEN"
    write_lines "$FROZEN" "$left"
    return $failed
}

# --- cold swap ---------------------------------------------------------------

# The zram swap devices with a disk behind them, one name per line.
zram_backed() {
    local dev
    for dev in $(awk '$1 ~ /^\/dev\/zram[0-9]+$/ {print substr($1, 6)}' /proc/swaps); do
        [[ -e $SYS/block/$dev/backing_dev && $(<"$SYS/block/$dev/backing_dev") != none ]] && echo "$dev"
    done
}

# While this stay lasts, in the background at idle CPU and disk priority:
# every WRITEBACK_LATER seconds, what has sat untouched in zram swap that
# long goes to the disk behind it (see the top). A quick return to the
# desktop finds nothing there yet.
writeback_later() {
    local id
    { read -r id <"$SESSION"; } 2>/dev/null && [[ -n $(zram_backed) ]] || return 0
    (
        exec 9>&- </dev/null >/dev/null 2>&1
        chrt --idle -p 0 "$BASHPID" || renice -n 19 -p "$BASHPID"
        ionice -c 3 -p "$BASHPID"
        NOTE_DIR=$SESSIONS/$id
        while sleep "$WRITEBACK_LATER" && [[ -e $ON && ! -e $LEFT && $(<"$SESSION") == "$id" ]]; do
            for dev in $(zram_backed); do
                read -r _ _ used _ <"$SYS/block/$dev/mm_stat"
                read -r _ _ written <"$SYS/block/$dev/bd_stat"
                if ! sudo -n "$WRITEBACK_HELPER" writeback "$dev" "$WRITEBACK_LATER"; then
                    note writeback device="$dev" ok:=false
                    continue
                fi
                read -r _ _ now _ <"$SYS/block/$dev/mm_stat"
                read -r _ _ after <"$SYS/block/$dev/bd_stat"
                ((after > written)) && note writeback device="$dev" ok:=true \
                    written:=$(((after - written) * 4 / 1024)) freed:=$(((used - now) / 1048576))
            done
        done
    ) &
}

# --- Steam's UI --------------------------------------------------------------

# Steam's browser processes, one pid per line: read from /proc without a
# process per entry (a few hundred, on every refresh). An ended one, a zombie
# until its stopped parent reaps it, is not one.
steam_ui_pids() {
    local p s
    for p in /proc/[0-9]*; do
        [[ -O $p ]] || continue
        { read -r s <"$p/stat"; } 2>/dev/null || continue
        [[ $s == *" (steamwebhelper) "* ]] || continue
        s=${s##*) }
        [[ ${s%% *} != Z ]] && echo "${p#/proc/}"
    done
}

# The windows Steam opens again on asking, by title.
steam_ui_url() {
    case "$1" in
        Steam) echo steam://open/main ;;
        "Friends List") echo steam://open/friends ;;
        *) return 1 ;;
    esac
}

# End Steam's UI (see the top) when the Steam behind it is part of the game:
# every browser process in one of the game's cgroups, none of them the game's
# own (a Steam dialog on the gaming workspace, or what the game talks to:
# refresh tries again), and a sandbox between each and Steam in that same
# cgroup. A Steam that is not the game's is left to the freezer, whole.
stop_steam_ui() {
    local pid up cg mem key value start ok
    local -a ui chain=()
    local -A isui=() seen=()
    mapfile -t ui < <(steam_ui_pids)
    if [[ -d $STEAMUI ]]; then
        # Ended already; unless a leave that did not finish let it go on, and
        # Steam started it again: what that record still holds goes on too.
        ((${#ui[@]})) || return 0
        resume_steam_sandbox || return 0
        rm -rf "$STEAMUI"
    fi
    ((${#ui[@]})) || return 0
    for pid in "${ui[@]}"; do
        if has "$PROTECTED" "$pid"; then
            log "Steam's UI is part of the game: left running"
            return 0
        fi
        has "$PROTECTED_CG" "$(cgroup_of "$pid")" || return 0
        isui[$pid]=1
    done
    # The sandbox: what is between each topmost browser process and Steam.
    for pid in "${ui[@]}"; do
        up=$(parent_of "$pid")
        [[ -n $up ]] || continue # (ended meanwhile)
        [[ -n ${isui[$up]:-} ]] && continue
        if has "$PROTECTED" "$up"; then
            log "Steam's UI has no sandbox: left running"
            return 0
        fi
        cg=$(cgroup_of "$pid")
        while :; do
            if [[ -z $up ]] || ((up <= 1)) || [[ $(cgroup_of "$up") != "$cg" ]]; then
                log "Steam's UI is not below the game's Steam: left running"
                return 0
            fi
            [[ -n ${seen[$up]:-} ]] && break
            has "$PROTECTED" "$up" && break
            seen[$up]=1
            chain+=("$up")
            up=$(parent_of "$up")
        done
    done
    ((${#chain[@]})) || return 0
    mkdir -p "$STEAMUI" || return 0
    # Its windows Steam can open again, and what it holds, for the journal.
    if ! (for pid in "${chain[@]}"; do
        start=$(starttime_of "$pid") || exit 1
        echo "$pid $start"
    done) >"$STEAMUI/parked" ||
        ! jq -r --argjson ui "[$(IFS=,; echo "${ui[*]}")]" \
            '.[] | select(.pid as $p | $ui | index($p)) | [.title, .workspace.name] | @tsv' <<<"$CLIENTS" |
        while IFS=$'\t' read -r title ws; do
            if steam_ui_url "$title" >/dev/null; then printf '%s\t%s\n' "$title" "$ws"; fi
        done >"$STEAMUI/windows"; then
        rm -rf "$STEAMUI"
        return 0
    fi
    mem=0
    for pid in "${ui[@]}"; do
        { while read -r key value _; do [[ $key == Pss: ]] && mem=$((mem + value)); done <"/proc/$pid/smaps_rollup"; } 2>/dev/null || continue
    done
    kill -STOP "${chain[@]}" 2>/dev/null
    for _ in $(seq 1 20); do
        ok=1
        for pid in "${chain[@]}"; do [[ $(state_of "$pid") == [Tt] ]] || ok=0; done
        ((ok)) && break
        sleep 0.1
    done
    if ! ((ok)); then
        kill -CONT "${chain[@]}" 2>/dev/null
        rm -rf "$STEAMUI"
        log "Steam's sandbox did not stop: its UI left running"
        return 0
    fi
    # (A process it started meanwhile goes in a later round.)
    for _ in 1 2 3; do
        mapfile -t ui < <(steam_ui_pids)
        ((${#ui[@]})) || break
        kill -KILL "${ui[@]}" 2>/dev/null
        sleep 0.1
    done
    mapfile -t ui < <(steam_ui_pids)
    if ((${#ui[@]})); then
        log "Steam's UI did not all end (${ui[*]} left), its sandbox stopped: ${chain[*]}"
        note steam_ui action=end ok:=false left:="${#ui[@]}"
        return 0
    fi
    log "ended Steam's UI ($((mem / 1024)) MiB), its sandbox stopped: ${chain[*]}"
    note steam_ui action=end ok:=true memory:="$((mem / 1024))" windows:="$(wc -l <"$STEAMUI/windows")"
}

# Let the stopped sandbox go on: it finds the UI gone and exits, and Steam
# starts it again. What could not be let go on stays in the record.
resume_steam_sandbox() {
    local pid start left=""
    [[ -e $STEAMUI/parked ]] || return 0
    while read -r pid start; do
        same_process "$pid" "$start" || continue
        kill -CONT "$pid" 2>/dev/null || ! same_process "$pid" "$start" || left+="$pid $start"$'\n'
    done <"$STEAMUI/parked"
    write_lines "$STEAMUI/parked" "$left"
    [[ -z $left ]]
}

# Steam's UI back, and its windows that were open opened again where they
# were, in the background (Steam takes a few seconds).
start_steam_ui() {
    local id lines
    [[ -d $STEAMUI ]] || return 0
    if ! resume_steam_sandbox; then
        note steam_ui action=resume ok:=false
        return 1
    fi
    note steam_ui action=resume ok:=true
    lines=$(cat "$STEAMUI/windows" 2>/dev/null)
    rm -rf "$STEAMUI"
    [[ -n $lines ]] || return 0
    { read -r id <"$SESSION"; } 2>/dev/null || id=""
    (
        exec 9>&- </dev/null >/dev/null 2>&1
        NOTE_DIR=${id:+$SESSIONS/$id}
        while IFS=$'\t' read -r title ws; do
            reopen_steam_window "$id" "$title" "$ws" || break
        done <<<"$lines"
    ) &
    return 0
}

# Off (or leaving), and no stay begun since SESSION's: a window opened now
# would not land over a game.
steam_window_due() {
    local now
    [[ ! -e $ON || -e $LEFT ]] && { read -r now <"$SESSION"; } 2>/dev/null && [[ $now == "$1" ]]
}

# Ask Steam for a window once its new UI is up, placed by a rule of its own
# (made again for each ask: a config reload meanwhile drops it), until it
# shows. Never while a stay is on, and never starting a Steam that ended.
reopen_steam_window() { # reopen_steam_window SESSION TITLE WORKSPACE
    local id=$1 title=$2 ws=$3 url rule shown=false
    url=$(steam_ui_url "$title") || return 0
    [[ $ws == special:* || $ws =~ ^[0-9]+$ ]] || ws="name:$ws"
    [[ $ws != *"]==]"* ]] || return 0
    rule=GamingModeSteamWindow$BASHPID
    # (Asked before the new UI is up, Steam forgets it.)
    for _ in $(seq 1 300); do
        [[ -n $(steam_ui_pids) ]] && break
        sleep 0.1
    done
    if [[ -n $(steam_ui_pids) ]]; then
        for _ in $(seq 1 15); do
            steam_window_due "$id" && pgrep -x -u "$UID" steam >/dev/null || break
            hyprctl eval "if $rule then pcall(function() $rule:set_enabled(false) end) end
                $rule = hl.window_rule({ name = \"gaming-mode-steam-window-$BASHPID\",
                    match = { class = \"^(steam)\$\", title = [==[^($title)\$]==] },
                    workspace = [==[$ws silent]==], no_initial_focus = true })" >/dev/null || break
            timeout 10 steam "$url"
            for _ in $(seq 1 20); do
                if hyprctl -j clients | jq -e --arg t "$title" 'any(.[]; .class == "steam" and .title == $t)' >/dev/null; then
                    shown=true
                    break 2
                fi
                sleep 0.1
            done
        done
        hyprctl eval "if $rule then pcall(function() $rule:set_enabled(false) end) end
            $rule = nil" >/dev/null
    fi
    note steam_window title="$title" workspace="$3" ok:=$shown
    [[ $shown == true ]]
}

# --- the backdrop ------------------------------------------------------------

# While on, the gaming workspace's screen shows the desktop asleep: a still
# picture (gaming-mode-art) through swaybg, wherever no fullscreen window
# covers it. Covered, it is closed, so a game in front of it costs nothing.
# swaybg runs as a transient user service in session.slice: outside the apps
# that are frozen, never a child of this script (it would hold the lock), and
# gone with `systemctl stop` whatever became of the script that started it.
# The plain picture is drawn ahead of time, so it is up before the shell
# goes; the one with the readout replaces it once that is known. A layer
# rule in windowrules.lua keeps it from fading out (a fade is a screen-sized
# snapshot).

# "OUTPUT WIDTH HEIGHT SHOWN" of the gaming workspace's screen, in pixels,
# SHOWN being "empty" while that screen shows the gaming workspace with no
# window on it (else "-"); nothing when what the screen shows covers it
# (unless "any": a fullscreen window, or one over 85% of it, as gaming.lua
# tells too), or the gaming workspace is nowhere.
backdrop_place() {
    local monitors workspaces clients
    monitors=$(hyprctl -j monitors) && workspaces=$(hyprctl -j workspaces) && clients=$(hyprctl -j clients) || return 1
    jq -r --arg ws "$GAMING_WS" --argjson wss "$workspaces" --argjson cs "$clients" --arg any "${1:-}" '
        first($wss[] | select(.name == $ws)) as $g
        | .[] | select(.name == $g.monitor) | . as $m
        | ($m.width / $m.scale * $m.height / $m.scale) as $area
        | select($any == "any" or (
            (first($wss[] | select(.id == $m.activeWorkspace.id)) | .hasfullscreen | not) and
            ([$cs[] | select(.workspace.id == $m.activeWorkspace.id and (.hidden | not)
                and .size[0] * .size[1] >= 0.85 * $area)] | length == 0)))
        | "\(.name) \(.width) \(.height) \(if .activeWorkspace.id == $g.id and $g.windows == 0 then "empty" else "-" end)"' \
        <<<"$monitors"
}

# The picture for OUTPUT at WIDTH x HEIGHT: this stay's, with the readout, if
# drawn; the plain one if drawn before; nothing until one is.
backdrop_picture() {
    local id file
    { read -r id <"$SESSION"; } 2>/dev/null
    file=$SESSIONS/$id/backdrop-$1-${2}x$3.png
    if [[ -n $id && -s $file ]]; then
        echo "$file"
    elif [[ -s $ART_CACHE/plain-$1-${2}x$3.png ]]; then
        echo "$ART_CACHE/plain-$1-${2}x$3.png"
    fi
}

# Show PICTURE on OUTPUT. The new one is drawn before the one it replaces
# goes, so the screen is never black between them.
backdrop_show() { # backdrop_show OUTPUT PICTURE
    local unit pid u
    unit=gaming-mode-backdrop-${EPOCHREALTIME/[.,]/}.service
    systemd-run --user --quiet --collect --unit="$unit" --slice=session.slice -p TimeoutStopSec=2 \
        -- swaybg -o "$1" -i "$2" -m fill 9>&- </dev/null >/dev/null 2>&1 || return 1
    echo "$unit $1 $2" >"$BACKDROP"
    pid=$(systemctl --user show -p MainPID --value -- "$unit")
    for _ in $(seq 1 20); do
        hyprctl -j layers | jq -e --arg o "$1" --argjson p "${pid:-0}" \
            '[.[$o].levels[]?[]? | select(.pid == $p)] | length > 0' >/dev/null && break
        sleep 0.1
    done
    sleep 0.1 # (listed is not yet drawn)
    for u in $(systemctl --user list-units --plain --no-legend 'gaming-mode-backdrop-*.service' | awk '{print $1}'); do
        [[ $u == "$unit" ]] || systemctl --user stop -- "$u"
    done
}

# Close the backdrop, every one there may be.
backdrop_close() {
    systemctl --user stop 'gaming-mode-backdrop-*.service' 2>/dev/null
    rm -f "$BACKDROP"
}

# Show the backdrop where it belongs, or close it (under the lock): while on,
# and in the lobby (the gaming workspace on screen with no game yet; the
# desktop stays awake).
backdrop_follow() {
    local place out w h what pic unit shown id
    place=$(backdrop_place) || return 0
    read -r out w h what <<<"$place"
    if [[ -e $ON && ! -e $LEFT ]]; then
        [[ -n $place ]] && pic=$(backdrop_picture "$out" "$w" "$h")
    elif [[ ! -e $ON && ${what:-} == empty ]]; then
        if [[ -s $ART_CACHE/lobby-$out-${w}x$h.png ]]; then
            pic=$ART_CACHE/lobby-$out-${w}x$h.png
        else
            prerender_later sync # (shown once drawn)
        fi
    fi
    if [[ -z ${pic:-} ]]; then
        [[ -e $BACKDROP ]] && backdrop_close
        return 0
    fi
    { read -r unit shown <"$BACKDROP"; } 2>/dev/null
    [[ ${shown:-} == "$out $pic" ]] && systemctl --user -q is-active -- "$unit" && return 0
    backdrop_show "$out" "$pic"
    # The plain picture up once the stay is ready: the readout is drawn now
    # that it can be seen.
    { read -r id <"$SESSION"; } 2>/dev/null
    [[ $pic == "$ART_CACHE"/* && -e $SESSIONS/${id:-}/ready ]] && readout_later 0
    return 0
}

# Leaving: the backdrop goes once the shell's own wallpaper is back on its
# screen (if that screen had one), so the screen is never black between.
backdrop_leave() {
    local unit out pid
    { read -r unit out _ <"$BACKDROP"; } 2>/dev/null
    if [[ -n ${out:-} ]] && has "$(cat "$WALLS" 2>/dev/null)" "$out"; then
        pid=$(systemctl --user show -p MainPID --value -- "$unit")
        for _ in $(seq 1 30); do
            hyprctl -j layers | jq -e --arg o "$out" --argjson p "${pid:-0}" \
                '[.[$o].levels["0"][]? | select(.pid != $p)] | length > 0' >/dev/null && break
            sleep 0.1
        done
    fi
    backdrop_close
}

# In DELAY seconds, in the background: how much VRAM the desktop gave back
# (once), and the picture with the readout, shown if this stay is still on.
# Drawn at idle priority, and only while the backdrop can be seen: under a
# game it would cost the game memory for nothing. The rest (the driver query,
# the lock) at the priority of what started it, so nothing waits behind a
# starved process.
# One at a time.
readout_later() { # readout_later DELAY
    local id
    { read -r id <"$SESSION"; } 2>/dev/null && [[ -d $SESSIONS/$id && ! -e $SESSIONS/$id/readout-pending ]] || return 0
    touch "$SESSIONS/$id/readout-pending"
    (
        exec 9>&- </dev/null >/dev/null 2>&1
        sleep "$1"
        exec "$SELF" readout "$id"
    ) &
}

readout() { # readout SESSION
    local id=$1 dir before after place out w h now
    [[ $id =~ ^[0-9-]+$ && -d $SESSIONS/$id ]] || return 1
    dir=$SESSIONS/$id
    if [[ -e $dir/vram-before ]]; then
        before=$(awk '{s += $2} END {print s + 0}' "$dir/vram-before")
        after=$(vram_by_pid | awk 'NR == FNR {want[$1]; next} $1 in want {s += $2} END {print s + 0}' "$dir/vram-before" -)
        NOTE_DIR=$dir note vram desktop_before:="$before" desktop_after:="$after"
        rm -f "$dir/vram-before"
    fi
    if ! place=$(backdrop_place) || [[ -z $place ]]; then
        rm -f "$dir/readout-pending" # (covered: asked again when it shows)
        return 0
    fi
    read -r out w h _ <<<"$place"
    # (A failed drawing keeps the plain picture, and is not tried again.)
    chrt --idle 0 "$BIN_DIR/gaming-mode-review" --readout "$id" |
        chrt --idle 0 "$BIN_DIR/gaming-mode-art" readout "$out" "$w" "$h" "$dir/backdrop-$out-${w}x$h.png" || return 1
    rm -f "$dir/readout-pending"
    exec 9>"$STATE_DIR/lock"
    flock 9
    { read -r now <"$SESSION"; } 2>/dev/null
    [[ ${now:-} == "$id" ]] && backdrop_follow
}

# At idle priority, in the background: the plain and lobby pictures for the
# gaming workspace's screen (or the focused one), redrawn if the wallpaper
# changed; enter and the lobby only look them up. After leaving (desktop
# time, not the game's), or for a lobby with none drawn yet ("sync": sync
# again once drawn, so it shows). One at a time.
prerender_later() {
    local pending=$STATE_DIR/prerender-pending
    [[ -e $pending ]] && return 0
    touch "$pending"
    (
        exec 9>&- </dev/null >/dev/null 2>&1
        chrt --idle -p 0 "$BASHPID" || renice -n 19 -p "$BASHPID"
        place=$(backdrop_place any)
        [[ -n $place ]] || place=$(hyprctl -j monitors | jq -r 'first(.[] | select(.focused)) | "\(.name) \(.width) \(.height)"')
        read -r out w h _ <<<"$place"
        [[ -n ${h:-} ]] && "$BIN_DIR/gaming-mode-art" prepare "$out" "$w" "$h"
        drawn=$?
        rm -f "$pending"
        ((drawn == 0)) && [[ ${1:-} == sync ]] && exec "$SELF" sync
    ) &
}

# --- the review panel ---------------------------------------------------------

# After leaving, the review panel (Quickshell, files/quickshell/gaming-mode)
# on the focused screen, a transient user service like the backdrop. Never
# over a game on screen: after pause, or off while the game shows, it is due
# until a sync finds none; a game coming back on screen closes it. Closed
# before anything is stopped or frozen, so the shell is never taken for it.
PANEL=$STATE_DIR/panel # the panel was opened

panel_follow() {
    local shown=0
    [[ -e $REVIEW || -e $PANEL ]] || return 0
    gaming_shown || shown=$?
    if ((shown == 0)); then
        panel_close
    elif ((shown != 2)) && [[ -e $REVIEW ]]; then
        panel_open
    fi
}

panel_open() {
    local output
    rm -f "$REVIEW"
    command -v quickshell >/dev/null || return 0
    systemctl --user -q is-active -- "$PANEL_UNIT" && return 0 # (it follows the journal itself)
    output=$(hyprctl -j monitors | jq -r 'first(.[] | select(.focused)) | .name // empty')
    touch "$PANEL"
    systemd-run --user --quiet --collect --unit="$PANEL_UNIT" --slice=session.slice -p TimeoutStopSec=2 \
        --setenv=GAMING_MODE_OUTPUT="$output" --setenv=QT_QUICK_BACKEND=software \
        -- quickshell --no-duplicate --path "$HOME/.config/quickshell/gaming-mode" 9>&- </dev/null >/dev/null 2>&1
}

panel_close() {
    [[ -e $PANEL ]] || return 0
    systemctl --user stop -- "$PANEL_UNIT" 2>/dev/null # (waits for it to end)
    rm -f "$PANEL"
}

# --- the panel's buttons ------------------------------------------------------

# act SESSION ACTION [ARG]: what the panel's buttons run (through systemd-run,
# so never inside the panel, which enter closes). Under the lock, and only
# for the stay the panel showed: a click that waited behind a return to the
# game finds another stay and does nothing.
#   retry            leave again, with every record's tries reset
#   forget RECORD    give up restoring one: shell/ID, terms/ID or screen/CONNECTOR
#                    (a screen is handed back to hotplug detection once more)
#   back             show the gaming workspace, as Super+G does
#   back-paused      the same, keeping the desktop (pause)
#   resume           undo a pause
#   restart RECORD   start a shell again that came back and has since ended
#   close            ask the game's windows to close
#   kill             end the game at once: the processes behind its windows
#                    and below them, never one with a window elsewhere
#   screen-off       disconnect the TV (display-mode off)
#   screen-on        connect it again
act() {
    local id addr pid
    local -a pids
    { read -r id <"$SESSION"; } 2>/dev/null
    if [[ -z ${id:-} || $1 != "$id" ]]; then
        log "act $2: for stay $1, now ${id:-none}: ignored"
        return 1
    fi
    note act action="$2" arg="${3:-}"
    case $2 in
        retry | forget)
            [[ -e $ON && -e $LEFT ]] || return 0
            if [[ $2 == forget ]]; then
                case ${3:-} in
                    shell/* | terms/*)
                        [[ ${3#*/} =~ ^[A-Za-z0-9]+$ ]] || return 1
                        log "forgot ${3%%/*} record: $(tr '\0' ' ' <"$STATE_DIR/$3/cmdline" 2>/dev/null)"
                        rm -rf -- "${STATE_DIR:?}/$3"
                        ;;
                    screen/*)
                        # (Handed back to hotplug detection once more, not left off.)
                        grep -qxF -- "${3#*/}" "$DISPLAYS" 2>/dev/null || return 1
                        sudo -n "$DISPLAY_HELPER" detect "${3#*/}"
                        drop_line "$DISPLAYS" "${3#*/}" && log "forgot screen ${3#*/}"
                        ;;
                    *) return 1 ;;
                esac
            fi
            rm -f "$RETRIES" "$SHELLS"/*/tries "$TERMS"/*/tries
            LEAVE_TRIGGER=retry
            leave_or_retry
            ;;
        back | back-paused)
            [[ $2 == back-paused ]] && touch "$PAUSED"
            hyprctl eval 'if GamingWorkspaceShow then GamingWorkspaceShow() end' >/dev/null
            ;;
        resume)
            rm -f "$PAUSED"
            ENTER_TRIGGER=resumed
            follow
            ;;
        restart)
            [[ ${3:-} =~ ^[A-Za-z0-9]+$ && -d $SESSIONS/$id/restored/${3:-} ]] || return 1
            [[ ! -e $ON || -e $LEFT ]] || return 0 # (on: the shell stays stopped)
            mkdir -p "$SHELLS"
            rm -rf "${SHELLS:?}/$3"
            cp -r "$SESSIONS/$id/restored/$3" "$SHELLS/$3" || return 1
            rm -f "$SHELLS/$3/tries"
            uptime_ticks >"$SHELLS/$3/since"
            start_shell
            ;;
        close)
            for addr in $(game_window_list address); do
                [[ $addr =~ ^0x[0-9a-f]+$ ]] && hyprctl dispatch "hl.dsp.window.close({ window = 'address:$addr' })" >/dev/null
            done
            ;;
        kill)
            mapfile -t pids < <(game_processes)
            ((${#pids[@]})) && kill -KILL "${pids[@]}" 2>/dev/null
            log "killed the game: ${pids[*]}"
            ;;
        screen-off | screen-on)
            [[ -x $BIN_DIR/display-mode ]] || return 1
            "$BIN_DIR/display-mode" "${2#screen-}" 9>&- </dev/null
            ;;
        *) return 2 ;;
    esac
}

# The game's windows on the gaming workspace (Steam's own dialogs, such as
# its "Launching..." one, are not the game), one FIELD per line.
game_window_list() {
    hyprctl -j clients | jq -r --arg ws "$GAMING_WS" --arg f "$1" \
        '.[] | select(.workspace.name == $ws and .class != "steam") | .[$f] | tostring'
}

# The game's processes: those behind its windows and all below them, but
# none that has a window elsewhere, nor the compositor or Xwayland, nor this
# script or what called it.
game_processes() {
    local clients pid up
    local -a queue
    local -A skip=()
    clients=$(hyprctl -j clients) || return 1
    for pid in $(jq -r --arg ws "$GAMING_WS" '.[] | select(.workspace.name != $ws) | .pid' <<<"$clients") \
        $(pgrep -x 'Hyprland|Xwayland'); do
        skip[$pid]=1
    done
    up=$$
    while [[ -n $up ]] && ((up > 1)); do skip[$up]=1; up=$(parent_of "$up"); done
    mapfile -t queue < <(game_window_list pid | sort -u)
    while ((${#queue[@]})); do
        pid=${queue[0]}
        queue=("${queue[@]:1}")
        [[ $pid =~ ^[0-9]+$ ]] && ((pid > 1)) && [[ -z ${skip[$pid]:-} ]] || continue
        skip[$pid]=1
        echo "$pid"
        mapfile -t -O "${#queue[@]}" queue < <(pgrep -P "$pid")
    done
}

# --- transitions -----------------------------------------------------------

enter() {
    local id
    renice -n 10 -p $$ >/dev/null # (under the game: its work waits for the game's)
    panel_close
    # (After a leave that did not finish: what is now part of the game must
    # not stay frozen under it.)
    thaw_apps protected
    touch "$ON"
    rm -f "$CLAIMED" "$LEFT" "$RETRIES" "$REVIEW" "$VISIT"
    new_session
    log "enter (game pids: $(tr '\n' ' ' <<<"$GAME_PIDS"))"
    note enter trigger="$ENTER_TRIGGER" game:="$(game_windows)" \
        oom_kills:="$(awk '$1 == "oom_kill" {print $2}' /proc/vmstat)"
    # (First: switching layouts reloads Hyprland's config, which would undo
    # what is set at runtime below.)
    mirror_screens
    # What the desktop holds in VRAM now, to tell what it gave back (readout).
    { read -r id <"$SESSION"; } 2>/dev/null &&
        vram_by_pid | awk 'NR == FNR {game[$1]; next} !($1 in game)' <(echo "$GAME_TREE") - >"$SESSIONS/$id/vram-before"
    # The screens with a wallpaper, and the plain backdrop up before it goes.
    hyprctl -j layers | jq -r 'to_entries[] | select((.value.levels["0"] // []) | length > 0) | .key' >"$WALLS"
    backdrop_follow
    if [[ ! -e $ANR ]]; then
        hyprctl -j getoption misc:enable_anr_dialog |
            jq -r 'if has("bool") then .bool else .int != 0 end' >"$ANR.new" && mv "$ANR.new" "$ANR" &&
            hyprctl eval 'hl.config({ misc = { enable_anr_dialog = false } })' >/dev/null
    fi
    stop_shell
    close_terminals
    stop_steam_ui
    freeze_apps
    writeback_later
    note ready
    { read -r id <"$SESSION"; } 2>/dev/null && touch "$SESSIONS/$id/ready"
    readout_later 2 # (what the desktop held takes a moment to be freed)
}

# While on: the game's windows may have changed. Thaw what is now part of
# the game, stop a shell that came back, freeze what started since.
refresh() {
    local id game
    renice -n 10 -p $$ >/dev/null
    panel_close
    # A config reload meanwhile (a layout switch, say) undid these.
    [[ -e $ANR ]] && hyprctl eval 'hl.config({ misc = { enable_anr_dialog = false } })' >/dev/null
    [[ -e $NOANIM ]] && hyprctl eval "if not GamingModeNoAnim then $NOANIM_RULE end" >/dev/null
    thaw_apps protected
    stop_shell
    stop_steam_ui
    freeze_apps
    # The game as it is now (at enter it may have been a launcher's dialog).
    game=$(game_windows)
    { read -r id <"$SESSION"; } 2>/dev/null
    if [[ -n ${id:-} && $game != "$(cat "$SESSIONS/$id/game" 2>/dev/null)" ]]; then
        echo "$game" >"$SESSIONS/$id/game"
        note game windows:="$game"
        rm -f "$SESSIONS/$id/game-closed"
    fi
}

leave() {
    local failed=0 ok=true visit=false trigger
    log "leave"
    # (A retry is the leave it retries; off and pause are themselves.)
    trigger=$LEAVE_TRIGGER
    if [[ $trigger != retry ]] || ! { read -r trigger <"$LEFT"; } 2>/dev/null || [[ -z $trigger ]]; then
        trigger=$LEAVE_TRIGGER # (a retry of an unknown leave: a whole one)
        echo "$trigger" >"$LEFT"
    fi
    if [[ $trigger == left && -n $(game_window_list address) ]]; then
        visit=true
        [[ -e $VISIT ]] || uptime_s >"$VISIT"
    fi
    note leave trigger="$LEAVE_TRIGGER" game:="$(game_windows)" visit:=$visit
    thaw_apps || failed=1
    if [[ $visit == false ]]; then
        start_steam_ui || failed=1
    fi
    reconnect_displays || failed=1
    start_shell || failed=1
    if [[ $visit == false ]]; then
        unmirror_screens || failed=1
    fi
    backdrop_leave
    reopen_terminals || failed=1
    restore_layer_fades || { note step name=fades ok:=false; failed=1; }
    if [[ -e $ANR ]]; then
        if hyprctl eval "hl.config({ misc = { enable_anr_dialog = $(<"$ANR") } })" >/dev/null; then
            rm -f "$ANR"
        else
            note step name=anr ok:=false
            failed=1
        fi
    fi
    ((failed)) && ok=false
    note left ok:=$ok
    if ((failed)); then
        log "leave incomplete"
        return 1
    fi
    rm -f "$ON" "$PINNED" "$CLAIMED" "$LEFT"
    if [[ $visit == true ]]; then
        rm -f "$REVIEW" # (due once the stay is over: end_visit)
        [[ -d $STEAMUI ]] && sync_later "$STEAM_LATER"
    else
        rm -f "$VISIT"
    fi
    prerender_later
}

# After a visit to the desktop (leave): once the game's windows are gone the
# stay is over, and the screens' layout and Steam's UI go back as they were,
# the review panel due; while they are up, Steam's UI comes back once the
# visit has lasted STEAM_LATER seconds (asked again until it has). What fails
# is tried again at the next sync, and status lists it.
end_visit() { # end_visit [now]: over whatever is on screen (off, pause)
    local game="" since
    [[ -e $VISIT || -e $MIRRORED || -d $STEAMUI ]] || return 0
    [[ ${1:-} == now ]] || game=$(game_window_list address) || return 0
    if [[ -z $game ]]; then
        # (Once: what fails is tried again at the next sync.)
        if [[ -e $VISIT ]]; then
            log "the game's windows are gone: the stay is over"
            note over
            rm -f "$VISIT"
            touch "$REVIEW"
        fi
        start_steam_ui
        unmirror_screens
        return 0
    fi
    [[ -d $STEAMUI ]] || return 0
    { read -r since <"$VISIT"; } 2>/dev/null || since=0
    if (($(uptime_s) - since >= STEAM_LATER)) && { log "the visit lasts: Steam's UI back"; start_steam_ui; }; then
        return 0
    fi
    # (Hidden, the gaming workspace sends no syncs while the visit lasts.)
    sync_later "$STEAM_LATER"
}

# Leave, and on failure try again in 10 s, six times at most. The panel is
# due after the first try, and again if the last one fails.
leave_or_retry() {
    local n
    [[ -e $RETRIES ]] || touch "$REVIEW"
    if leave; then
        rm -f "$RETRIES"
        return 0
    fi
    n=$(cat "$RETRIES" 2>/dev/null || echo 0)
    if ((n < 6)); then
        echo $((n + 1)) >"$RETRIES"
        note retry in:=10 attempt:=$((n + 1))
        sync_later 10
    else
        log "leave still incomplete after $n retries: see status"
        note gave_up retries:="$n"
        touch "$REVIEW"
    fi
    return 1
}

# The game's windows are gone while on: noted once (until they are back),
# for the review.
game_closed() {
    local id
    { read -r id <"$SESSION"; } 2>/dev/null && [[ -d $SESSIONS/$id && ! -e $SESSIONS/$id/game-closed ]] || return 0
    touch "$SESSIONS/$id/game-closed"
    log "the game's windows are gone: staying on until the gaming workspace leaves the screen"
    note game_closed
}

# Follow the gaming workspace: on while it is shown with a window, or forced;
# still on while it is shown empty after that (the game closed, or a
# launcher's dialog went before the game's window came), until it leaves
# the screen.
follow() {
    local shown=0
    gaming_shown || shown=$?
    [[ -e $PINNED ]] && shown=0
    if ((shown == 0)); then
        if discover; then
            # (After a leave that did not finish, coming back is a new stay.)
            if [[ -e $ON && ! -e $LEFT ]]; then refresh; else enter; fi
        else
            log "the game can't be found for sure: nothing changed"
        fi
        backdrop_follow
        return 0
    fi
    if ((shown == 2)); then
        [[ -e $ON || -e $VISIT ]] && sync_later 2 # Hyprland can't be asked right now: ask again
        return 1
    fi
    # A leave that did not finish is tried again wherever the workspace is.
    if [[ -e $ON && -e $LEFT ]]; then
        LEAVE_TRIGGER=retry
        leave_or_retry
        return
    fi
    if ((shown == 3)); then
        if [[ -e $ON ]]; then game_closed; else end_visit; fi
        backdrop_follow
        return 0
    fi
    if [[ -e $ON ]]; then
        leave_or_retry
    else
        end_visit
        backdrop_follow
    fi
}

# --- report ----------------------------------------------------------------

snap_cpu() {
    local p s
    local -a st
    for p in /proc/[0-9]*; do
        { read -r s <"$p/stat"; } 2>/dev/null || continue
        read -r -a st <<<"${s##*) }" # the fields after "pid (comm) "
        echo "${p#/proc/} $((st[11] + st[12])) $(tr -d ' ' <"$p/comm" 2>/dev/null)"
    done | sort -k1,1
}

report() {
    local a b
    a=$(snap_cpu)
    sleep 3
    b=$(snap_cpu)
    echo "CPU over 3 s (ms per second):"
    join <(echo "$a") <(echo "$b") |
        awk -v hz="$(getconf CLK_TCK)" '{ms = ($4 - $2) * 1000 / hz / 3; if (ms >= 1) printf "  %6.1f  %s (%s)\n", ms, $3, $1}' |
        sort -rn | head -15
    if command -v nvidia-smi >/dev/null; then
        echo "VRAM: $(nvidia-smi --query-gpu=memory.used,memory.reserved,memory.total --format=csv,noheader) (used, driver-reserved, total)"
        nvidia-smi | awk '$6 ~ /^(G|C|C\+G)$/ && $(NF-1) ~ /MiB$/ {
            name = $7; for (i = 8; i < NF - 1; i++) name = name " " $i
            printf "  %8s  %s (%s)\n", $(NF-1), name, $5 }'
    fi
}

# --- main ------------------------------------------------------------------

mkdir -p "$STATE_DIR"
# (backdrop is asked on every fullscreen change: nothing to do while off.)
[[ ${1:-} == backdrop && ! -e $ON && ! -e $BACKDROP ]] && exit 0
case "${1:-}" in
    sync | on | off | pause | resume | backdrop | act)
        exec 9>"$STATE_DIR/lock"
        flock 9
        ;;
esac

case "${1:-}" in
    sync)
        if [[ ! -e $PAUSED ]]; then
            follow
        elif [[ -e $ON ]]; then
            LEAVE_TRIGGER=pause
            leave_or_retry
        fi
        panel_follow
        ;;
    on)
        rm -f "$PAUSED"
        touch "$PINNED"
        ENTER_TRIGGER=forced
        follow
        ;;
    off)
        rm -f "$PINNED"
        LEAVE_TRIGGER=off
        if [[ -e $ON ]]; then leave_or_retry; else end_visit now; fi
        panel_follow
        ;;
    pause)
        touch "$PAUSED"
        LEAVE_TRIGGER=pause
        if [[ -e $ON ]]; then leave_or_retry; else end_visit now; fi
        panel_follow
        ;;
    resume)
        rm -f "$PAUSED"
        ENTER_TRIGGER=resumed
        follow
        panel_follow
        ;;
    backdrop) backdrop_follow ;;
    act)
        shift
        act "$@"
        status=$?
        panel_follow
        exit $status
        ;;
    readout) readout "${2:-}" ;;
    status)
        if [[ -e $ON ]]; then
            echo "on$([[ -e $PINNED ]] && echo ' (forced)')"
        else
            echo "off$([[ -e $PAUSED ]] && echo ' (paused)')"
        fi
        for n in "$SHELLS"/*/; do
            [[ -d $n ]] || continue
            if [[ -e $n/unit ]]; then echo "stopped unit: $(<"$n/unit")"; else echo "stopped: $(tr '\0' ' ' <"$n/cmdline")"; fi
        done
        for n in "$TERMS"/*/; do
            [[ -d $n ]] && echo "closed terminal on workspace $(<"$n/workspace"): $(tr '\0' ' ' <"$n/cmdline")$(tr '\n' ' ' <"$n/attach")"
        done
        if [[ -e $DISPLAYS ]]; then sed 's/^/disconnected: /' "$DISPLAYS"; fi
        if [[ -e $VISIT ]]; then echo "visiting the desktop: the stay is over once the game's windows are gone"; fi
        if [[ -e $MIRRORED ]]; then echo "screens mirrored (extended again after)"; fi
        if [[ -e $FROZEN ]]; then sed "s|^$APPS/|frozen: |" "$FROZEN"; fi
        if [[ -e $STEAMUI/parked ]]; then echo "Steam's UI ended, its sandbox stopped: $(cut -d' ' -f1 "$STEAMUI/parked" | tr '\n' ' ')"; fi
        ;;
    report) report ;;
    *)
        echo "usage: gaming-mode sync|on|off|pause|resume|status|report|backdrop|act SESSION ACTION [ARG]" >&2
        exit 2
        ;;
esac
