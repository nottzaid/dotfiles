#!/usr/bin/env bash
# The scratchpad world: a second set of numbered workspaces laid over the
# normal ones. Scratchpad workspace N is Hyprland's special workspace
# "special:N". A monitor shows at most one special workspace, so a monitor is
# "in the scratchpad world" while it shows one of them. Each monitor has its
# own: scratchpad workspace N belongs to the monitor that owns normal
# workspace N (1-5 on one screen, 6-10 on the other), just like the normal
# workspaces, and each monitor remembers where it last was in its world.
#
# Every workspace keybind and the bar go through this script, so the same keys
# work in both worlds:
#   scratch-world toggle                  Super+S: enter this monitor's world at
#                                         its last workspace, or leave it
#   scratch-world send                    Super+Shift+S: move the focused window
#                                         to the other world (where you last were)
#   scratch-world focus SELECTOR          show workspace N, m+1, m-1, or emptym
#   scratch-world move SELECTOR [--silent]  move the focused window there (m~I too)
# --monitor NAME before the command acts on that monitor (the bar's own).
#
# In the normal world, focus goes through workspace-stream and move is the
# plain Hyprland dispatch, exactly as the keybinds did before. In the
# scratchpad world, m+1/m-1/m~I/emptym walk the monitor's own numbers, and
# moving between its workspaces slides sideways like normal workspaces do;
# only entering and leaving use the vertical special-workspace slide.
set -Eeuo pipefail

STATE_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/scratch-world"
# How long the sideways slide stays configured: a little over the
# "workspaces" animation (speed 5 = 500 ms, files/hypr/config/animations.lua).
SLIDE_SECONDS="${SCRATCH_WORLD_SLIDE_SECONDS:-0.6}"

die() {
    printf 'scratch-world: %s\n' "$*" >&2
    exit 1
}

dispatch() {
    hyprctl dispatch "$1" >/dev/null
}

monitor=""
if [[ "${1:-}" == "--monitor" ]]; then
    monitor="${2:?missing monitor name}"
    shift 2
fi

mkdir -p "$STATE_DIR"
# One at a time: fast scroll ticks must each see the previous tick's result,
# or two of them would toggle the same workspace and close it.
exec 9>"$STATE_DIR/lock"
flock 9

monitors="$(hyprctl -j monitors)"
workspaces="$(hyprctl -j workspaces)"
focused="$(jq -r '.[] | select(.focused) | .name' <<<"$monitors")"
if [[ -n "$monitor" && "$monitor" != "$focused" ]]; then
    dispatch "hl.dsp.focus({ monitor = \"$monitor\" })"
    focused="$monitor"
fi
active="$(jq -r --arg m "$focused" '.[] | select(.name == $m) | .activeWorkspace.id' <<<"$monitors")"

# The scratchpad world workspace MONITOR shows, if any.
scratch_on() {
    local shown
    shown="$(jq -r --arg m "$1" '.[] | select(.name == $m) | .specialWorkspace.name' <<<"$monitors")"
    if [[ "$shown" =~ ^special:([1-9][0-9]*)$ ]]; then
        printf '%s\n' "${BASH_REMATCH[1]}"
    fi
}
current="$(scratch_on "$focused")"

# The numbers of MONITOR's normal workspaces, in order.
numbers_of() {
    jq -r --arg m "$1" '[.[] | select(.id > 0 and .monitor == $m) | .id] | sort | .[]' <<<"$workspaces"
}

# The monitor that owns number N; numbers no monitor has stay here.
owner() {
    local m
    m="$(jq -r --argjson n "$1" '.[] | select(.id == $n) | .monitor' <<<"$workspaces")"
    printf '%s\n' "${m:-$focused}"
}

# MONITOR's last scratchpad world workspace, at first its lowest number.
last() {
    local n
    local -a numbers
    n="$(cat "$STATE_DIR/last-$1" 2>/dev/null || true)"
    if [[ ! "$n" =~ ^[1-9][0-9]*$ ]]; then
        mapfile -t numbers < <(numbers_of "$1")
        n="${numbers[0]:-1}"
    fi
    printf '%s\n' "$n"
}

remember() {
    printf '%s\n' "$2" >"$STATE_DIR/last-$1"
}

# Moving from scratchpad workspace FROM to TO slides sideways like normal
# workspaces ("right" toward a higher number). Hyprland reads the style when
# an animation starts, so the vertical slide comes back once this one has
# played, unless another sideways move came since.
slide_sideways() {
    local direction=left token=$$
    (($2 > $1)) && direction=right
    hyprctl eval "ScratchWorldSlide(\"$direction\")" >/dev/null
    printf '%s\n' "$token" >"$STATE_DIR/sideways"
    (
        exec 9>&-
        sleep "$SLIDE_SECONDS"
        exec 9>"$STATE_DIR/lock"
        flock 9
        [[ "$(cat "$STATE_DIR/sideways" 2>/dev/null)" == "$token" ]] || exit 0
        hyprctl eval 'ScratchWorldSlide()' >/dev/null
        rm -f "$STATE_DIR/sideways"
    ) >/dev/null 2>&1 &
}

# Entering or leaving the world: make sure the vertical slide is back.
slide_vertical() {
    [[ -e "$STATE_DIR/sideways" ]] || return 0
    hyprctl eval 'ScratchWorldSlide()' >/dev/null
    rm -f "$STATE_DIR/sideways"
}

# Show scratchpad workspace N on the monitor that owns it, like Super+N
# does for normal workspaces on the other screen.
show() {
    local n="$1" target on
    target="$(owner "$n")"
    if [[ "$target" != "$focused" ]]; then
        dispatch "hl.dsp.focus({ monitor = \"$target\" })"
    fi
    on="$(scratch_on "$target")"
    [[ "$n" == "$on" ]] && return
    if [[ -n "$on" ]]; then
        slide_sideways "$on" "$n"
    else
        slide_vertical
    fi
    # toggle_special shows a workspace that is not open on this monitor,
    # replacing the one that is.
    dispatch "hl.dsp.workspace.toggle_special(\"$n\")"
    remember "$target" "$n"
}

# SELECTOR -> scratchpad workspace number, mirroring Hyprland's meaning of it.
resolve() {
    local selector="$1" n i
    local -a numbers
    mapfile -t numbers < <(numbers_of "$focused")
    ((${#numbers[@]} > 0)) || numbers=("$current")
    case "$selector" in
    m+1)
        for n in "${numbers[@]}"; do
            ((n > current)) && { printf '%s\n' "$n"; return; }
        done
        printf '%s\n' "${numbers[0]}"
        ;;
    m-1)
        for ((i = ${#numbers[@]} - 1; i >= 0; i--)); do
            ((numbers[i] < current)) && { printf '%s\n' "${numbers[i]}"; return; }
        done
        printf '%s\n' "${numbers[-1]}"
        ;;
    m~*)
        n="${selector#m~}"
        [[ "$n" =~ ^[1-9][0-9]*$ ]] && ((n <= ${#numbers[@]})) || return 1
        printf '%s\n' "${numbers[n - 1]}"
        ;;
    emptym)
        for n in "${numbers[@]}"; do
            if jq -e --arg name "special:$n" 'all(.[]; .name != $name or .windows == 0)' \
                <<<"$workspaces" >/dev/null; then
                printf '%s\n' "$n"
                return
            fi
        done
        return 1
        ;;
    *)
        [[ "$selector" =~ ^[1-9][0-9]*$ ]] || die "unsupported selector: $selector"
        printf '%s\n' "$selector"
        ;;
    esac
}

case "${1:-}" in
toggle)
    if [[ -n "$current" ]]; then
        remember "$focused" "$current"
        slide_vertical
        dispatch "hl.dsp.workspace.toggle_special(\"$current\")"
    else
        show "$(last "$focused")"
    fi
    ;;
send)
    if [[ -n "$current" ]]; then
        # Back to the normal workspace underneath, the last one used there.
        dispatch "hl.dsp.window.move({ workspace = \"$active\", follow = false })"
    else
        dispatch "hl.dsp.window.move({ workspace = \"special:$(last "$focused")\", follow = false })"
    fi
    ;;
focus)
    selector="${2:?missing workspace selector}"
    if [[ -z "$current" ]]; then
        exec 9>&-
        exec "$HOME/.local/bin/workspace-stream" workspace "$selector"
    fi
    n="$(resolve "$selector")" || exit 0
    show "$n"
    ;;
move)
    selector="${2:?missing workspace selector}"
    silent=""
    [[ "${3:-}" == "--silent" ]] && silent=", follow = false"
    if [[ -z "$current" ]]; then
        dispatch "hl.dsp.window.move({ workspace = \"$selector\"$silent })"
        exit 0
    fi
    n="$(resolve "$selector")" || exit 0
    [[ "$n" == "$current" ]] && exit 0
    if [[ -z "$silent" ]]; then
        # Following the window shows its workspace here, which is now the last one.
        slide_sideways "$current" "$n"
        remember "$focused" "$n"
    fi
    dispatch "hl.dsp.window.move({ workspace = \"special:$n\"$silent })"
    ;;
*)
    die "usage: scratch-world [--monitor NAME] toggle | send | focus SELECTOR | move SELECTOR [--silent]"
    ;;
esac
